<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_primary }}">
  <link rel="canonical" href="{{ canonical_url }}">
  <title>{{ shop.name }} — {{ 'gift_card.title' | t }}</title>
  {{ content_for_header }}
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ 'nayro-shopify.css' | asset_url | stylesheet_tag }}
  <style>
    body { margin: 0; background: {{ settings.color_bg }}; color: {{ settings.color_text }}; font-family: var(--n-font-body, 'Inter', system-ui, sans-serif); }
    .gift-card-page { min-height: 100vh; display: grid; place-items: center; padding: 32px 16px; }
    .gift-card-box { width: min(520px, 100%); background: #fff; border-radius: 24px; box-shadow: 0 24px 60px rgba(15, 23, 42, .14); padding: 36px; text-align: center; }
    .gift-card-box h1 { margin: 0 0 6px; font-size: 28px; }
    .gift-card-box p { color: #475467; margin: 0 0 20px; }
    .gift-card-balance { font-size: 42px; font-weight: 700; color: {{ settings.color_primary }}; margin: 18px 0 4px; }
    .gift-card-code { display: inline-block; margin: 18px 0; padding: 14px 22px; border: 1px dashed rgba(15, 23, 42, .3); border-radius: 12px; font-size: 20px; letter-spacing: .14em; font-weight: 600; }
    .gift-card-box .nayro-btn { display: inline-flex; margin: 6px 4px; }
    .gift-card-expired { background: #fef2f2; color: #b91c1c; padding: 12px 16px; border-radius: 10px; margin: 16px 0; }
    @media print { .gift-card-actions { display: none; } body { background: #fff; } .gift-card-box { box-shadow: none; } }
  </style>
</head>
<body>
  <main id="MainContent" class="gift-card-page" role="main">
    {{ content_for_layout }}
  </main>
</body>
</html>
