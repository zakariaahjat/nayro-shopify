<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_primary }}">
  {{ content_for_header }}
  <title>{{ shop.name }} – {{ 'password.title' | t }}</title>
  <meta name="description" content="{{ shop.description | default: shop.name | escape }}">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- if settings.favicon != blank %}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 96 }}">
  {%- endif %}
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ 'modern.css' | asset_url | stylesheet_tag }}
  {{ 'nayro-shopify.css' | asset_url | stylesheet_tag }}
  <style>
    :root {
      --n-primary: {{ settings.color_primary }};
      --n-primary-dark: {{ settings.color_primary_dark }};
      --n-text: {{ settings.color_text }};
      --n-muted: {{ settings.color_muted }};
      --n-bg: {{ settings.color_bg }};
      --n-surface: {{ settings.color_surface }};
      --n-surface-2: {{ settings.color_surface | color_darken: 4 }};
      --n-border: {{ settings.color_border }};
      --n-sale: {{ settings.color_sale }};
      --n-container: {{ settings.container_width }}px;
    }
    body.nayro-password { min-height: 100vh; display: flex; flex-direction: column; }
    .nayro-password__main { flex: 1 1 auto; display: grid; place-items: center; padding: 48px 16px; }
    .nayro-password__logo img { max-height: 54px; width: auto; }
    .nayro-password__logo-text { font-family: var(--n-font-head); font-size: 30px; font-weight: 800; color: var(--n-text); }
    .nayro-password__note { margin-top: 20px; font-size: 13px; color: var(--n-muted); }
    .nayro-password__login { max-width: 560px; margin: 26px auto 0; }
    .nayro-password__login summary { cursor: pointer; font-weight: 700; color: var(--n-primary); }
  </style>
</head>
<body class="nayro-site nayro-woo nayro-password">
  <main id="MainContent" class="nayro-password__main" role="main">
    {{ content_for_layout }}
  </main>
  <script src="{{ 'nayro.js' | asset_url }}" defer></script>
</body>
</html>
