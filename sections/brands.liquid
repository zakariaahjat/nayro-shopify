<div class="nayro-home">
  <section class="nh-section" id="brands-{{ section.id }}">
    <div class="nh-wrap">
      <div class="nh-head">
        <div>
          {%- if section.settings.eyebrow != blank -%}
            <span class="nh-eyebrow">{{ section.settings.eyebrow | escape }}</span>
          {%- endif -%}
          <h2 class="nh-title">{{ section.settings.title | default: 'Shop by brand' | escape }}</h2>
        </div>
        {%- if section.settings.show_link -%}
          <a class="nh-link" href="{{ routes.all_products_collection_url }}">{{ section.settings.link_label | default: 'All products' | escape }} {% render 'icon', name: 'arrow', class: 'nh-icon' %}</a>
        {%- endif -%}
      </div>

      <div class="nh-brands">
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            {%- liquid
              assign brand_name = block.settings.name | strip
              assign brand_count = block.settings.count | plus: 0

              # Live count from the storefront vendor filter when Search & Discovery
              # provides it. The manual "Products count" setting always wins.
              if brand_count == 0 and brand_name != blank
                assign brand_key = brand_name | downcase
                for vendor_filter in collections.all.filters
                  if vendor_filter.param_name == 'filter.p.vendor'
                    for vendor_value in vendor_filter.values
                      assign vendor_key = vendor_value.label | strip | downcase
                      if vendor_key == brand_key
                        assign brand_count = vendor_value.count
                      endif
                    endfor
                  endif
                endfor
              endif
            -%}
            {%- if block.settings.link != blank -%}
              <a class="nh-brand" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
            {%- else -%}
              <span class="nh-brand" {{ block.shopify_attributes }}>
            {%- endif -%}
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 240', sizes: '140px', alt: brand_name | escape }}
              {%- elsif brand_name != blank -%}
                <span class="nh-brand__name">{{ brand_name | escape }}</span>
              {%- endif -%}
              {%- if brand_count > 0 -%}
                <span class="nh-brand__count" title="{{ 'collections.general.product_count' | t | escape }}">{{ brand_count }}</span>
              {%- endif -%}
            {%- if block.settings.link != blank -%}</a>{%- else -%}</span>{%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {%- assign fallback_brands = 'Apple,Samsung,Dell,Lenovo,HP,Sony,Asus,Acer,MSI,Xiaomi,Huawei,Google,Microsoft,LG,Motorola,Nokia,OnePlus,Oppo,Realme,Honor,TCL,Hisense,Philips,Logitech,Razer,Corsair,Kingston,SanDisk,Seagate,Western Digital,Intel,AMD,NVIDIA,Canon,Nikon,JBL,Bose,Anker,TP-Link,Epson,Brother,Gigabyte' | split: ',' -%}
          {%- for brand_name in fallback_brands -%}
            {%- assign brand_q = brand_name | url_encode -%}
            {%- assign brand_url = routes.collections_url | append: '/vendors?q=' | append: brand_q -%}
            <a class="nh-brand" href="{{ brand_url }}"><span class="nh-brand__name">{{ brand_name | escape }}</span></a>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Brands",
  "class": "nayro-brands-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Trusted names"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Shop by brand"
    },
    {
      "type": "checkbox",
      "id": "show_link",
      "label": "Show link",
      "default": true
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "All products"
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Brand name",
          "default": "Apple"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "number",
          "id": "count",
          "label": "Products count",
          "info": "Leave at 0 to show the live count from the Vendor filter (Search & Discovery). Set a number to override it."
        }
      ]
    }
  ],
  "max_blocks": 60,
  "presets": [
    {
      "name": "Brands",
      "blocks": [
        { "type": "brand", "settings": { "name": "Apple" } },
        { "type": "brand", "settings": { "name": "Samsung" } },
        { "type": "brand", "settings": { "name": "Dell" } },
        { "type": "brand", "settings": { "name": "Lenovo" } },
        { "type": "brand", "settings": { "name": "HP" } },
        { "type": "brand", "settings": { "name": "Sony" } },
        { "type": "brand", "settings": { "name": "Asus" } },
        { "type": "brand", "settings": { "name": "Acer" } }
      ]
    }
  ]
}
{% endschema %}
