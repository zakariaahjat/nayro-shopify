{%- liquid
  assign menu = section.settings.menu
  assign account_url = routes.account_login_url
  if shop.customer_accounts_enabled
    assign account_url = routes.account_url
  endif
  if pages.wishlist != blank
    assign wishlist_url = pages.wishlist.url
  else
    assign wishlist_url = routes.root_url | append: '/pages/wishlist' | replace_first: '//', '/'
  endif
  assign sell_url = section.settings.sell_link
  if sell_url == blank and settings.whatsapp_number != blank
    assign sell_message = settings.whatsapp_message | url_encode
    assign sell_url = 'https://wa.me/' | append: settings.whatsapp_number | append: '?text=' | append: sell_message
  endif
-%}

<header class="nayro-header" id="nayro-header">
  <div class="nayro-container nayro-header__inner">
    <button type="button" class="nayro-icon-btn nayro-burger" id="nayro-burger" data-open-panel="mobile-menu" aria-controls="nayro-mobile-menu" aria-expanded="false" aria-label="{{ 'general.accessibility.open_menu' | t }}">
      {% render 'icon', name: 'menu' %}
    </button>

    <div class="nayro-logo">
      <a class="nayro-logo__link" href="{{ routes.root_url }}" rel="home">
        {%- if settings.logo != blank -%}
          <img
            src="{{ settings.logo | image_url: width: 400 }}"
            alt="{{ shop.name | escape }}"
            width="{{ settings.logo_width }}"
            height="{{ settings.logo_width | divided_by: settings.logo.aspect_ratio | round }}"
            style="width: {{ settings.logo_width }}px; max-height: 52px; object-fit: contain;"
            loading="eager"
          >
        {%- else -%}
          <span class="nayro-logo__text"><span class="nayro-logo__mark">N</span><span>{{ shop.name | default: 'nayro' }}</span></span>
        {%- endif -%}
      </a>
    </div>

    {%- if section.settings.show_search -%}
      <div class="nayro-search">
        <form class="nayro-search__form" action="{{ routes.search_url }}" method="get" role="search">
          <label class="nayro-visually-hidden" for="HeaderSearch">{{ 'general.accessibility.search' | t }}</label>
          <input
            class="nayro-search__input"
            id="HeaderSearch"
            type="search"
            name="q"
            value="{{ search.terms | escape }}"
            placeholder="{{ 'general.search_placeholder' | t }}"
            autocomplete="off"
          >
          <input type="hidden" name="options[prefix]" value="last">
          <input type="hidden" name="type" value="product">
          <button type="submit" class="nayro-search__btn" aria-label="{{ 'search.submit' | t }}">
            {% render 'icon', name: 'search' %}
          </button>
        </form>
      </div>
    {%- endif -%}

    <div class="nayro-actions">
      {%- if settings.enable_dark_mode -%}
        <button type="button" class="nayro-icon-btn nayro-theme-toggle" id="nayro-theme-toggle" aria-label="{{ 'general.accessibility.toggle_dark_mode' | t }}" title="{{ 'general.accessibility.toggle_dark_mode' | t }}">
          <svg class="nayro-icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg class="nayro-icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        </button>
      {%- endif -%}

      {%- if section.settings.show_account -%}
        <a class="nayro-icon-btn nayro-actions__link" href="{{ account_url }}" aria-label="{{ 'sections.header.account' | t }}">
          {% render 'icon', name: 'user' %}
        </a>
      {%- endif -%}

      {%- if settings.enable_wishlist -%}
        <a class="nayro-icon-btn nayro-actions__link nayro-wishlist-link" href="{{ wishlist_url }}" aria-label="{{ 'sections.header.wishlist' | t }}">
          {% render 'icon', name: 'heart' %}
          <span class="nayro-count" data-wishlist-count>0</span>
        </a>
      {%- endif -%}

      <button type="button" class="nayro-icon-btn nayro-cart-btn" id="nayro-cart-btn" data-open-panel="cart" aria-controls="nayro-cart-drawer" aria-expanded="false" aria-label="{{ 'general.accessibility.open_cart' | t }}">
        {% render 'icon', name: 'cart' %}
        <span class="nayro-cart-count" data-cart-count>{{ cart.item_count }}</span>
      </button>
    </div>
  </div>

  {%- if menu != blank and menu.links.size > 0 -%}
    <div class="nayro-nav-wrap">
      <nav class="nayro-mainnav nayro-container" aria-label="{{ 'general.accessibility.menu' | t }}">
        <ul class="nayro-menu">
          {%- for link in menu.links -%}
            <li class="nayro-menu__item{% if link.current %} current-menu-item{% endif %}{% if link.links.size > 4 %} nayro-mega{% endif %}">
              <a href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>
                {{ link.title | escape }}
                {%- if link.links.size > 0 -%}
                  <span class="nayro-caret" aria-hidden="true">{% render 'icon', name: 'chevron-down' %}</span>
                {%- endif -%}
              </a>
              {%- if link.links.size > 0 -%}
                <ul class="nayro-dropdown">
                  {%- for child in link.links -%}
                    <li class="{% if child.current %}current-menu-item{% endif %}">
                      <a href="{{ child.url }}" {% if child.current %}aria-current="page"{% endif %}>{{ child.title | escape }}</a>
                      {%- if child.links.size > 0 -%}
                        <ul class="nayro-submenu">
                          {%- for grandchild in child.links -%}
                            <li><a href="{{ grandchild.url }}">{{ grandchild.title | escape }}</a></li>
                          {%- endfor -%}
                        </ul>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>

        <div class="nayro-nav-cta">
          {%- if section.settings.show_shop_link -%}
            <a class="nayro-nav-shop" href="{{ routes.all_products_collection_url }}">
              {% render 'icon', name: 'box' %}
              {{ 'general.shop' | t }}
            </a>
          {%- endif -%}
          {%- if section.settings.show_sell_button and sell_url != blank -%}
            <a class="nayro-btn nayro-btn--primary nayro-btn--sm" href="{{ sell_url }}" {% if section.settings.sell_link == blank %}target="_blank" rel="noopener"{% endif %}>
              {{ section.settings.sell_label | default: 'Sell with us' | escape }}
            </a>
          {%- endif -%}
        </div>
      </nav>
    </div>
  {%- endif -%}

  <span class="nayro-header__progress" id="nayro-progress" aria-hidden="true"></span>
</header>

<aside class="nayro-mobile-panel" id="nayro-mobile-menu" aria-label="{{ 'general.accessibility.menu' | t }}" aria-hidden="true">
  <div class="nayro-mobile-panel__head">
    <span class="nayro-logo__text"><span class="nayro-logo__mark">N</span><span>{{ shop.name | default: 'nayro' }}</span></span>
    <button type="button" class="nayro-icon-btn" data-close-panel aria-label="{{ 'general.accessibility.close_menu' | t }}">
      {% render 'icon', name: 'close' %}
    </button>
  </div>

  <form class="nayro-search__form" action="{{ routes.search_url }}" method="get" role="search">
    <label class="nayro-visually-hidden" for="MobileSearch">{{ 'general.accessibility.search' | t }}</label>
    <input class="nayro-search__input" id="MobileSearch" type="search" name="q" placeholder="{{ 'general.search_placeholder' | t }}">
    <input type="hidden" name="type" value="product">
    <button type="submit" class="nayro-search__btn" aria-label="{{ 'search.submit' | t }}">{% render 'icon', name: 'search' %}</button>
  </form>

  {%- if menu != blank and menu.links.size > 0 -%}
    <ul class="nayro-mobile-menu">
      {%- for link in menu.links -%}
        <li>
          <a href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>{{ link.title | escape }}</a>
          {%- if link.links.size > 0 -%}
            <ul class="nayro-submenu">
              {%- for child in link.links -%}
                <li><a href="{{ child.url }}">{{ child.title | escape }}</a></li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}

  {%- assign mobile_collections = collections | sort: 'title' -%}
  {%- if mobile_collections.size > 0 -%}
    <p class="nayro-mobile-panel__title">{{ 'general.categories' | t }}</p>
    <ul class="nayro-mobile-cats">
      {%- for collection in mobile_collections limit: 8 -%}
        <li>
          <a href="{{ collection.url }}">
            <span>{{ collection.title | escape }}</span>
            <span class="nayro-mobile-cats__count">{{ collection.all_products_count }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}

  <div class="nayro-mobile-panel__actions">
    <a class="nayro-btn nayro-btn--primary nayro-btn--block" href="{{ routes.all_products_collection_url }}">{{ 'general.shop' | t }}</a>
    <a class="nayro-btn nayro-btn--ghost nayro-btn--block" href="{{ account_url }}">{{ 'sections.header.account' | t }}</a>
    {%- if settings.enable_wishlist -%}
      <a class="nayro-btn nayro-btn--ghost nayro-btn--block" href="{{ wishlist_url }}">{{ 'sections.header.wishlist' | t }}</a>
    {%- endif -%}
  </div>
</aside>

{% schema %}
{
  "name": "Header",
  "class": "nayro-header-section",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Primary menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search bar",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show account link",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_shop_link",
      "label": "Show Shop shortcut in the menu bar",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sell_button",
      "label": "Show sell button",
      "default": true
    },
    {
      "type": "text",
      "id": "sell_label",
      "label": "Sell button label",
      "default": "Sell with us"
    },
    {
      "type": "url",
      "id": "sell_link",
      "label": "Sell button link",
      "info": "Leave empty to use WhatsApp."
    }
  ],
  "presets": [
    {
      "name": "Header"
    }
  ]
}
{% endschema %}
