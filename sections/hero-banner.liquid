<div class="nayro-home">
  <section class="nh-hero" aria-label="{{ 'general.home' | t }}">
    <div class="nh-slider" data-nh-slider aria-roledescription="carousel" aria-label="{{ 'sections.hero.slider_label' | t }}">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- assign loading_mode = 'lazy' -%}
          {%- if forloop.first -%}{%- assign loading_mode = 'eager' -%}{%- endif -%}
          <a class="nh-slide{% if forloop.first %} is-active{% endif %}" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {% unless forloop.first %}aria-hidden="true" tabindex="-1"{% endunless %} {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <picture>
                {%- if block.settings.image_mobile != blank -%}
                  <source media="(max-width: 720px)" srcset="{{ block.settings.image_mobile | image_url: width: 900 }}">
                {%- endif -%}
                {{ block.settings.image | image_url: width: 2000 | image_tag:
                  loading: loading_mode,
                  widths: '750, 1100, 1500, 2000',
                  sizes: '100vw',
                  alt: block.settings.heading | escape
                }}
              </picture>
            {%- endif -%}
            <span class="nh-slide__body">
              <span class="nh-slide__title">{{ block.settings.heading | default: 'Everything you need, new or used' | escape }}</span>
              {%- if block.settings.text != blank -%}
                <span class="nh-slide__text">{{ block.settings.text | escape }}</span>
              {%- endif -%}
              <span class="nh-btn nh-btn--light">
                {{ block.settings.button_label | default: 'Shop now' | escape }}
                {% render 'icon', name: 'arrow', class: 'nh-icon' %}
              </span>
            </span>
          </a>
        {%- endfor -%}
      {%- else -%}
        <a class="nh-slide is-active" href="{{ routes.all_products_collection_url }}">
          <span class="nh-slide__body">
            <span class="nh-slide__title">Everything you need, new or used</span>
            <span class="nh-btn nh-btn--light">
              Shop now
              {% render 'icon', name: 'arrow', class: 'nh-icon' %}
            </span>
          </span>
        </a>
      {%- endif -%}

      {%- if section.blocks.size > 1 -%}
        <div class="nh-dots">
          {%- for block in section.blocks -%}
            <button type="button" aria-label="{{ 'sections.hero.go_to_slide' | t }} {{ forloop.index }}" {% if forloop.first %}aria-current="true"{% endif %}></button>
          {%- endfor -%}
        </div>
        <div class="nh-slider__nav">
          <button type="button" data-dir="-1" aria-label="{{ 'general.accessibility.previous' | t }}">&lsaquo;</button>
          <button type="button" data-dir="1" aria-label="{{ 'general.accessibility.next' | t }}">&rsaquo;</button>
        </div>
      {%- endif -%}
    </div>

    <div class="nh-herobar">
      <div class="nh-wrap">
        {%- if section.settings.show_search -%}
          <form class="nh-search" role="search" action="{{ routes.search_url }}" method="get">
            <label class="nayro-visually-hidden" for="HomeSearch">{{ 'general.accessibility.search' | t }}</label>
            <input id="HomeSearch" type="search" name="q" placeholder="{{ section.settings.search_placeholder | default: 'Search laptops, phones, components…' | escape }}">
            <input type="hidden" name="type" value="product">
            <input type="hidden" name="options[prefix]" value="last">
            <button type="submit">{{ 'search.submit' | t }}</button>
          </form>
        {%- endif -%}

        {%- if section.settings.show_chips -%}
          {%- assign chip_collections = collections | sort: 'title' -%}
          {%- if chip_collections.size > 0 -%}
            <div class="nh-chips">
              {%- for collection in chip_collections limit: 5 -%}
                <a class="nh-chip" href="{{ collection.url }}">{{ collection.title | escape }}</a>
              {%- endfor -%}
            </div>
          {%- endif -%}
        {%- endif -%}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Hero banner",
  "class": "nayro-hero-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search bar",
      "default": true
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Search laptops, phones, components…"
    },
    {
      "type": "checkbox",
      "id": "show_chips",
      "label": "Show collection shortcuts",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop image"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Everything you need, new or used"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Laptops, phones and components — checked, guaranteed and delivered to your door."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Hero banner",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "heading": "Everything you need, new or used",
            "text": "Laptops, phones and components — checked, guaranteed and delivered to your door.",
            "button_label": "Shop now"
          }
        }
      ]
    }
  ]
}
{% endschema %}
