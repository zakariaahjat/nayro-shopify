<div class="nayro-page">
  <div class="nayro-container">
    {% render 'breadcrumbs' %}

    <div class="nayro-page__head">
      <span class="nayro-page__eyebrow">{{ section.settings.eyebrow | default: 'Help' | escape }}</span>
      <h1 class="nayro-page__title">{{ page.title | default: section.settings.title | escape }}</h1>
      {%- if section.settings.intro != blank -%}
        <p class="nayro-page__lead">{{ section.settings.intro | escape }}</p>
      {%- endif -%}
    </div>

    {%- if page.content != blank -%}
      <div class="nayro-prose rte" style="margin-bottom: 28px;">{{ page.content }}</div>
    {%- endif -%}

    <div class="nayro-faq">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <details class="nayro-faq__item" {% if forloop.first %}open{% endif %} {{ block.shopify_attributes }}>
            <summary>{{ block.settings.question | escape }}</summary>
            <div class="nayro-faq__answer">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      {%- else -%}
        <div class="nayro-empty-state">
          <p>{{ section.settings.empty_text | default: 'Add question blocks in the theme editor to build your FAQ.' | escape }}</p>
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.show_contact_cta -%}
      <div class="nayro-faq__cta">
        <p>{{ section.settings.cta_text | default: 'Still need help? Our team is happy to answer.' | escape }}</p>
        <a class="nayro-btn nayro-btn--primary" href="{{ section.settings.cta_link | default: pages.contact.url | default: routes.root_url }}">
          {{ section.settings.cta_label | default: 'Contact us' | escape }}
          {% render 'icon', name: 'arrow' %}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "FAQ",
  "class": "nayro-main-faq-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Help"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Fallback title",
      "default": "Frequently asked questions"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Introduction",
      "default": "Everything you need to know about ordering, delivery, returns and warranty."
    },
    {
      "type": "checkbox",
      "id": "show_contact_cta",
      "label": "Show contact link",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Contact text",
      "default": "Still need help? Our team is happy to answer."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Contact button",
      "default": "Contact us"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Contact link"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Empty-state text",
      "default": "Add question blocks in the theme editor to build your FAQ."
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How long does delivery take?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Orders are usually delivered within 1 to 3 business days.</p>"
        }
      ]
    }
  ],
  "max_blocks": 30,
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "faq", "settings": { "question": "How long does delivery take?", "answer": "<p>Orders are usually delivered within 1 to 3 business days.</p>" } },
        { "type": "faq", "settings": { "question": "Can I pay on delivery?", "answer": "<p>Yes, cash on delivery is available on eligible orders.</p>" } },
        { "type": "faq", "settings": { "question": "What is your return policy?", "answer": "<p>Contact us within 7 days of delivery to arrange a return or exchange on eligible products.</p>" } },
        { "type": "faq", "settings": { "question": "Is there a warranty?", "answer": "<p>Selected products include a warranty. The details are listed on the product page.</p>" } }
      ]
    }
  ]
}
{% endschema %}
