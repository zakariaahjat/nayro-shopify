<div class="nayro-password__content">
  <div class="nayro-customer__card" style="text-align: center;">
    <a class="nayro-password__logo" href="{{ routes.root_url }}">
      {%- if settings.logo != blank -%}
        <img src="{{ settings.logo | image_url: width: 400 }}" alt="{{ shop.name | escape }}" width="{{ settings.logo_width }}" height="54">
      {%- else -%}
        <img src="{{ 'nayro-logo.png' | asset_url }}" alt="{{ shop.name | default: 'nayro' | escape }}" width="{{ settings.logo_width }}" height="54">
      {%- endif -%}
    </a>

    <h1>{{ section.settings.title | default: 'Opening soon' | escape }}</h1>
    <p>{{ section.settings.text | default: 'We are working on something new. Enter your email to be the first to know.' | escape }}</p>

    {%- form 'customer', class: 'nayro-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="nayro-notice nayro-notice--success" role="status">{{ 'password.success' | t }}</p>
      {%- elsif form.errors -%}
        <div class="nayro-notice nayro-notice--error" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <label class="nayro-visually-hidden" for="PasswordNewsletterEmail">{{ 'password.email_placeholder' | t }}</label>
      <input id="PasswordNewsletterEmail" type="email" name="contact[email]" placeholder="{{ 'password.email_placeholder' | t }}" autocomplete="email" required>
      <button type="submit" class="nayro-btn nayro-btn--primary nayro-btn--block">{{ 'password.submit' | t }}</button>
    {%- endform -%}

    <details class="nayro-password__login">
      <summary>{{ 'password.login' | t }}</summary>
      {%- form 'storefront_password', class: 'nayro-form' -%}
        {%- if form.errors -%}
          <div class="nayro-notice nayro-notice--error" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <label class="nayro-visually-hidden" for="PasswordInput">{{ 'password.password_label' | t }}</label>
        <input id="PasswordInput" type="password" name="password" placeholder="{{ 'password.password_label' | t }}" autocomplete="current-password" required>
        <button type="submit" class="nayro-btn nayro-btn--ghost">{{ 'password.enter' | t }}</button>
      {%- endform -%}
    </details>

    {%- if section.settings.show_social -%}
      <div style="margin-top: 20px;">
        {% render 'social-icons' %}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Password",
  "class": "nayro-main-password-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Opening soon"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "We are working on something new. Enter your email to be the first to know."
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social icons",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Password"
    }
  ]
}
{% endschema %}
