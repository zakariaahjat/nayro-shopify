<div class="nayro-customer">
  <div class="nayro-customer__card">
    <h1>{{ 'customer.general.reset_password' | t }}</h1>

    {%- form 'reset_customer_password', class: 'nayro-form' -%}
      {%- if form.errors -%}
        <div class="nayro-notice nayro-notice--error" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}

      <div>
        <label for="ResetPassword">{{ 'customer.general.new_password' | t }}</label>
        <input id="ResetPassword" type="password" name="customer[password]" autocomplete="new-password" required>
      </div>

      <div>
        <label for="ResetPasswordConfirm">{{ 'customer.general.confirm_password' | t }}</label>
        <input id="ResetPasswordConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
      </div>

      <button type="submit" class="nayro-btn nayro-btn--primary nayro-btn--block">{{ 'customer.general.reset_password' | t }}</button>
    {%- endform -%}

    <p class="nayro-customer__note"><a href="{{ routes.account_login_url }}">{{ 'customer.general.back_to_login' | t }}</a></p>
  </div>
</div>

{% schema %}
{
  "name": "Reset password",
  "class": "nayro-main-reset-password-section",
  "settings": [],
  "presets": [
    {
      "name": "Reset password"
    }
  ]
}
{% endschema %}
