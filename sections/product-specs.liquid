{%- comment -%}
  Technical specifications ("Fiche technique") for the product page.

  Every row is optional. Rows come from three sources, in this order:

  1. "Row" blocks added in the theme editor (label + value). They are shared by
     every product that uses this product template. Use them for common rows
     such as warranty or delivery, or create a separate product template per
     product family and give each template its own rows.
  2. Built-in product attributes: brand, category, SKU, availability, tags.
     Each one has its own on/off switch in the theme editor.
  3. Product metafields in the namespace below (default: "specs"). This is the
     per-product option: create the definitions in Shopify admin -> Settings ->
     Custom data -> Products, then fill the value on each product.

  The section hides itself when there is nothing to show.
{%- endcomment -%}
{%- liquid
  assign spec_namespace_key = section.settings.namespace | strip | default: 'specs'
  assign spec_namespace = product.metafields[spec_namespace_key]
  assign current_variant = product.selected_or_first_available_variant
  assign spec_sku = current_variant.sku | default: product.variants.first.sku

  # A single JSON metafield holds every row: either an array of objects
  # ({ "label": "Length", "value": "5 m" }) or a plain object
  # ({ "Length": "5 m" }).
  assign json_key = section.settings.json_key | strip | default: 'fiche'
  assign spec_json = spec_namespace[json_key]
  assign json_source = ''
  assign json_found = false
  if spec_json != blank
    assign json_source = spec_namespace_key | append: '.' | append: json_key
    assign json_found = true
  endif

  # Be forgiving about where the definition was created: a "custom" namespace
  # is what Shopify suggests by default, and the name of the definition is
  # often used as the key instead of "fiche".
  if spec_json == blank
    assign spec_json = product.metafields.custom[json_key]
    if spec_json != blank
      assign json_source = 'custom.' | append: json_key
      assign json_found = true
    endif
  endif
  if spec_json == blank
    assign spec_json = product.metafields.custom.fiche
    if spec_json != blank
      assign json_source = 'custom.fiche'
      assign json_found = true
    endif
  endif
  if spec_json == blank
    assign spec_json = product.metafields.specs.fiche_technique
    if spec_json != blank
      assign json_source = 'specs.fiche_technique'
      assign json_found = true
    endif
  endif
  if spec_json == blank
    assign spec_json = product.metafields.custom.fiche_technique
    if spec_json != blank
      assign json_source = 'custom.fiche_technique'
      assign json_found = true
    endif
  endif
  if spec_json == blank
    assign spec_json = product.metafields.custom.specs
    if spec_json != blank
      assign json_source = 'custom.specs'
      assign json_found = true
    endif
  endif

  assign json_type = ''
  assign json_rows = ''
  assign json_lines = ''
  assign json_count = 0
  assign json_is_lines = false
  assign json_value = ''
  if section.settings.show_json and spec_json != blank
    assign json_type = spec_json.type | default: ''
    assign json_value = spec_json.value
    assign json_is_text = false
    if json_type contains 'text' or json_type contains 'string' or json_type contains 'url'
      assign json_is_text = true
    endif
    unless json_is_text
      assign json_rows = json_value
      for row in json_rows
        assign row_label = row.label | default: row.name | default: row.title
        assign row_value = row.value | default: row.text | default: row.content
        if row_label == blank
          assign row_label = row[0]
          assign row_value = row[1]
        endif
        if row_label != blank and row_value != blank
          assign json_count = json_count | plus: 1
        endif
      endfor
    endunless
    if json_count == 0 and json_value != blank
      # Not a JSON object/array (for example a text metafield filled with
      # "Label: value" lines), so read it line by line.
      assign json_lines = json_value | newline_to_br | split: '<br />'
      assign json_is_lines = true
      for spec_line in json_lines
        assign spec_line = spec_line | strip
        if spec_line == blank
          continue
        endif
        if spec_line contains '{' or spec_line contains '['
          continue
        endif
        assign spec_parts = spec_line | split: ':'
        assign spec_label = spec_parts[0] | strip
        assign spec_text = spec_parts | slice: 1, 50 | join: ':' | strip
        if spec_label != blank and spec_text != blank
          assign json_count = json_count | plus: 1
        endif
      endfor
    endif
  endif

  assign row_count = 0
  for block in section.blocks
    assign block_label = block.settings.label | strip
    assign block_value = block.settings.value | strip
    if block_label != blank and block_value != blank
      assign row_count = row_count | plus: 1
    endif
  endfor

  assign metafield_count = 0
  if section.settings.show_metafields
    for metafield in spec_namespace
      assign metafield_key = metafield.first | strip
      assign metafield_path = spec_namespace_key | append: '.' | append: metafield_key
      if metafield_path != json_source and metafield.last.value != blank
        assign metafield_count = metafield_count | plus: 1
      endif
    endfor
  endif

  assign builtin_count = 0
  if section.settings.show_vendor and product.vendor != blank
    assign builtin_count = builtin_count | plus: 1
  endif
  if section.settings.show_type and product.type != blank
    assign builtin_count = builtin_count | plus: 1
  endif
  if section.settings.show_sku and spec_sku != blank
    assign builtin_count = builtin_count | plus: 1
  endif
  if section.settings.show_availability
    assign builtin_count = builtin_count | plus: 1
  endif
  if section.settings.show_tags and product.tags.size > 0
    assign builtin_count = builtin_count | plus: 1
  endif

  assign specs_total = json_count | plus: row_count | plus: builtin_count | plus: metafield_count
-%}
{%- if specs_total > 0 -%}
  <section class="nayro-specs" id="specs-{{ section.id }}">
    <div class="nayro-container">
      <div class="nayro-specs__inner">
        <div class="nayro-specs__head">
          {%- if section.settings.eyebrow != blank -%}
            <span class="nayro-page__eyebrow">{{ section.settings.eyebrow | escape }}</span>
          {%- endif -%}
          <h2 class="nayro-specs__title">{{ section.settings.heading | default: 'Fiche technique' | escape }}</h2>
        </div>

        <dl class="nayro-specs__list">
          {%- if json_count > 0 -%}
            {%- if json_is_lines -%}
              {%- for spec_line in json_lines -%}
                {%- assign spec_line = spec_line | strip -%}
                {%- if spec_line == blank -%}{%- continue -%}{%- endif -%}
                {%- if spec_line contains '{' or spec_line contains '[' -%}{%- continue -%}{%- endif -%}
                {%- assign spec_parts = spec_line | split: ':' -%}
                {%- assign row_label = spec_parts[0] | strip -%}
                {%- assign row_value = spec_parts | slice: 1, 50 | join: ':' | strip -%}
                {%- if row_label != blank and row_value != blank -%}
                  <div class="nayro-specs__row">
                    <dt>{{ row_label | escape }}</dt>
                    <dd>{{ row_value | escape }}</dd>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            {%- else -%}
              {%- for row in json_rows -%}
                {%- assign row_label = row.label | default: row.name | default: row.title -%}
                {%- assign row_value = row.value | default: row.text | default: row.content -%}
                {%- if row_label == blank -%}
                  {%- assign row_label = row[0] -%}
                  {%- assign row_value = row[1] -%}
                {%- endif -%}
                {%- if row_label != blank and row_value != blank -%}
                  <div class="nayro-specs__row">
                    <dt>{{ row_label | escape }}</dt>
                    <dd>{{ row_value | escape | newline_to_br }}</dd>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          {%- endif -%}

          {%- for block in section.blocks -%}
            {%- assign block_label = block.settings.label | strip -%}
            {%- assign block_value = block.settings.value | strip -%}
            {%- if block_label != blank and block_value != blank -%}
              <div class="nayro-specs__row" {{ block.shopify_attributes }}>
                <dt>{{ block_label | escape }}</dt>
                <dd>{{ block_value | escape | newline_to_br }}</dd>
              </div>
            {%- endif -%}
          {%- endfor -%}

          {%- if section.settings.show_vendor and product.vendor != blank -%}
            <div class="nayro-specs__row">
              <dt>{{ section.settings.label_vendor | default: 'Marque' | escape }}</dt>
              <dd>{{ product.vendor | escape }}</dd>
            </div>
          {%- endif -%}

          {%- if section.settings.show_type and product.type != blank -%}
            <div class="nayro-specs__row">
              <dt>{{ section.settings.label_type | default: 'Catégorie' | escape }}</dt>
              <dd>{{ product.type | escape }}</dd>
            </div>
          {%- endif -%}

          {%- if section.settings.show_sku and spec_sku != blank -%}
            <div class="nayro-specs__row">
              <dt>{{ section.settings.label_sku | default: 'Référence' | escape }}</dt>
              <dd>{{ spec_sku | escape }}</dd>
            </div>
          {%- endif -%}

          {%- if section.settings.show_availability -%}
            <div class="nayro-specs__row">
              <dt>{{ section.settings.label_availability | default: 'Disponibilité' | escape }}</dt>
              <dd>
                {%- if product.available -%}
                  {{ 'products.product.in_stock' | t }}
                {%- else -%}
                  {{ 'products.product.out_of_stock' | t }}
                {%- endif -%}
              </dd>
            </div>
          {%- endif -%}

          {%- if section.settings.show_tags and product.tags.size > 0 -%}
            <div class="nayro-specs__row">
              <dt>{{ section.settings.label_tags | default: 'Tags' | escape }}</dt>
              <dd>{{ product.tags | join: ', ' | escape }}</dd>
            </div>
          {%- endif -%}

          {%- if section.settings.show_metafields -%}
            {%- for metafield in spec_namespace -%}
              {%- assign metafield_key = metafield.first | strip -%}
              {%- assign metafield_path = spec_namespace_key | append: '.' | append: metafield_key -%}
              {%- if metafield_path == json_source -%}{%- continue -%}{%- endif -%}
              {%- assign spec = metafield.last -%}
              {%- assign spec_value = spec.value -%}
              {%- if spec_value != blank -%}
                {%- assign spec_type = spec.type | default: '' -%}
                {%- assign spec_is_list = false -%}
                {%- if spec_type contains 'list' -%}
                  {%- assign spec_is_list = true -%}
                {%- elsif spec_type != 'json' and spec_value.first != blank -%}
                  {%- assign spec_is_list = true -%}
                {%- endif -%}
                {%- if spec_is_list -%}
                  {%- assign spec_value = spec_value | join: ', ' -%}
                {%- endif -%}
                <div class="nayro-specs__row">
                  <dt>{{ metafield.first | replace: '_', ' ' | replace: '-', ' ' | capitalize }}</dt>
                  <dd>
                    {%- if spec_type == 'rich_text_field' -%}
                      {{ spec_value }}
                    {%- else -%}
                      {{ spec_value | escape }}
                    {%- endif -%}
                  </dd>
                </div>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </dl>

        {%- if section.settings.note != blank -%}
          <p class="nayro-specs__note">{{ section.settings.note | escape | newline_to_br }}</p>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{%- if section.settings.show_debug -%}
  <div class="nayro-container" style="padding:12px 0">
    <pre style="margin:0;padding:12px;background:#f1f5f9;border:1px solid #cbd5e1;border-radius:8px;font-size:12px;white-space:pre-wrap">FICHE DEBUG
namespace: {{ spec_namespace_key }}
key: {{ json_key }}
metafield found: {{ json_found }}
source: {{ json_source | default: '(none)' }}
type: {{ json_type | default: '(none)' }}
rows rendered: {{ json_count }}
section show_json: {{ section.settings.show_json }}
total rows: {{ specs_total }}</pre>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Fiche technique",
  "class": "nayro-product-specs-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Fiche technique"
    },
    {
      "type": "header",
      "content": "JSON metafield"
    },
    {
      "type": "checkbox",
      "id": "show_json",
      "label": "Show the JSON metafield rows",
      "default": true
    },
    {
      "type": "text",
      "id": "json_key",
      "label": "JSON metafield key",
      "default": "fiche",
      "info": "Create one product metafield of type JSON with this key in the namespace above, then paste an array of { \"label\": \"...\", \"value\": \"...\" } objects."
    },
    {
      "type": "header",
      "content": "Rows from product metafields"
    },
    {
      "type": "checkbox",
      "id": "show_metafields",
      "label": "Show metafield rows",
      "default": true
    },
    {
      "type": "text",
      "id": "namespace",
      "label": "Metafield namespace",
      "default": "specs",
      "info": "Every non-empty product metafield in this namespace becomes a row. Set values per product in Shopify admin -> Settings -> Custom data -> Products."
    },
    {
      "type": "header",
      "content": "Built-in rows"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show brand",
      "default": false
    },
    {
      "type": "text",
      "id": "label_vendor",
      "label": "Brand label",
      "default": "Marque"
    },
    {
      "type": "checkbox",
      "id": "show_type",
      "label": "Show category",
      "default": false
    },
    {
      "type": "text",
      "id": "label_type",
      "label": "Category label",
      "default": "Catégorie"
    },
    {
      "type": "checkbox",
      "id": "show_sku",
      "label": "Show SKU",
      "default": true
    },
    {
      "type": "text",
      "id": "label_sku",
      "label": "SKU label",
      "default": "Référence"
    },
    {
      "type": "checkbox",
      "id": "show_availability",
      "label": "Show availability",
      "default": true
    },
    {
      "type": "text",
      "id": "label_availability",
      "label": "Availability label",
      "default": "Disponibilité"
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "Show tags",
      "default": false
    },
    {
      "type": "text",
      "id": "label_tags",
      "label": "Tags label",
      "default": "Tags"
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Note below the table"
    },
    {
      "type": "checkbox",
      "id": "show_debug",
      "label": "Show diagnostic info",
      "default": false,
      "info": "Prints the metafield namespace, key, type and rendered row count on the product page. Turn it off when everything works."
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Garantie"
        },
        {
          "type": "textarea",
          "id": "value",
          "label": "Value",
          "default": "12 mois"
        }
      ]
    }
  ],
  "max_blocks": 30,
  "presets": [
    {
      "name": "Fiche technique"
    }
  ]
}
{% endschema %}
