{%- comment -%}
  Facets. Accepts: results (collection or search), form_action, reset_url,
  current_sort (optional), is_search (optional), search_terms (optional),
  search_type (optional), preset_brands (optional, comma separated).

  Native Shopify filters are rendered when the merchant adds them in the
  Search & Discovery app. The Brand group is always rendered from the store
  vendors plus the preset brand list, so it does not shrink to a single vendor
  when the store has only one vendor name.
{%- endcomment -%}
{%- capture nayro_canonical_brands -%}{% render 'brand-list' %}{%- endcapture -%}
{%- liquid
  assign has_native_type = false
  for filter in results.filters
    if filter.param_name == 'filter.p.product_type'
      assign has_native_type = true
    endif
  endfor

  assign show_fallback_types = false
  if is_search != true and has_native_type == false and results.all_types.size > 0
    assign show_fallback_types = true
  endif

  # Brand list: the store's real vendors first, then the canonical list in
  # snippets/brand-list.liquid, then the theme editor setting. Duplicates are
  # removed, so brands without products yet still appear in the Brand filter.
  assign brand_names = ''
  assign brand_keys = '||'
  assign shop_name_key = shop.name | downcase
  for product_vendor in results.all_vendors
    assign vendor_clean = product_vendor | strip
    assign vendor_key = vendor_clean | downcase
    if vendor_key == shop_name_key
      continue
    endif
    assign brand_names = brand_names | append: vendor_clean | append: '||'
    assign brand_keys = brand_keys | append: vendor_key | append: '||'
  endfor

  assign brand_setting_csv = preset_brands | default: '' | strip
  assign preset_brand_csv = brand_setting_csv | append: ',' | append: nayro_canonical_brands
  assign preset_brand_list = preset_brand_csv | split: ','
  for preset_brand in preset_brand_list
    assign preset_brand = preset_brand | strip
    if preset_brand != blank
      assign preset_key = preset_brand | downcase
      assign preset_token = '||' | append: preset_key | append: '||'
      unless brand_keys contains preset_token
        assign brand_names = brand_names | append: preset_brand | append: '||'
        assign brand_keys = brand_keys | append: preset_token
      endunless
    endif
  endfor
  assign brand_list = brand_names | split: '||'
  assign brand_total = 0
  for brand_item in brand_list
    assign brand_item_clean = brand_item | strip
    if brand_item_clean != blank
      assign brand_total = brand_total | plus: 1
    endif
  endfor

  assign show_brand_filter = false
  if is_search != true and brand_list.size > 0
    assign show_brand_filter = true
  endif

  assign show_filters = false
  if results.filters.size > 0 or show_fallback_types or show_brand_filter
    assign show_filters = true
  endif

  assign current_type_key = collection.current_type | downcase
  assign current_vendor_key = collection.current_vendor | downcase
-%}
{%- if show_filters -%}
  <form id="NayroFacetsForm" class="nayro-filters" method="get" action="{{ form_action }}" data-facets-form>
    {%- if is_search -%}
      <input type="hidden" name="q" value="{{ search_terms | escape }}">
      <input type="hidden" name="options[prefix]" value="last">
      {%- if search_type != blank -%}
        <input type="hidden" name="type" value="{{ search_type }}">
      {%- endif -%}
    {%- endif -%}
    {%- if current_sort != blank -%}
      <input type="hidden" name="sort_by" value="{{ current_sort }}">
    {%- endif -%}
    {%- if virtual_q != blank -%}
      <input type="hidden" name="q" value="{{ virtual_q | escape }}">
    {%- endif -%}

    <div class="nayro-filters__head">
      <span class="nayro-filters__title">{{ 'collections.general.filters' | t }}</span>
      <a class="nayro-filters__reset" href="{{ reset_url }}">{{ 'collections.general.clear_all' | t }}</a>
    </div>

    {%- for filter in results.filters -%}
      {%- if filter.param_name == 'filter.p.vendor' -%}
        {%- for value in filter.active_values -%}
          <input type="hidden" name="{{ value.param_name }}" value="{{ value.value }}">
        {%- endfor -%}
        {%- continue -%}
      {%- endif -%}
      {%- assign filter_open = false -%}
      {%- if filter.active_values.size > 0 -%}
        {%- assign filter_open = true -%}
      {%- endif -%}
      {%- if filter.type == 'price_range' -%}
        {%- if filter.min_value.value != blank or filter.max_value.value != blank -%}
          {%- assign filter_open = true -%}
        {%- endif -%}
      {%- endif -%}
      <details class="nayro-filter-group" {% if filter_open %}open{% endif %}>
        <summary class="nayro-filter-group__title">{{ filter.label | escape }}</summary>

        {%- case filter.type -%}
          {%- when 'price_range' -%}
            <div class="nayro-filter-price">
              <div>
                <label for="Filter-{{ filter.label | handle }}-gte">{{ 'collections.general.from' | t }}</label>
                <input
                  type="number"
                  id="Filter-{{ filter.label | handle }}-gte"
                  name="{{ filter.min_value.param_name }}"
                  placeholder="0"
                  min="0"
                  max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                  value="{% if filter.min_value.value %}{{ filter.min_value.value | money_without_currency | replace: ',', '' }}{% endif %}"
                  data-facet-input
                >
              </div>
              <div>
                <label for="Filter-{{ filter.label | handle }}-lte">{{ 'collections.general.to' | t }}</label>
                <input
                  type="number"
                  id="Filter-{{ filter.label | handle }}-lte"
                  name="{{ filter.max_value.param_name }}"
                  placeholder="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                  min="0"
                  max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                  value="{% if filter.max_value.value %}{{ filter.max_value.value | money_without_currency | replace: ',', '' }}{% endif %}"
                  data-facet-input
                >
              </div>
            </div>

          {%- else -%}
            <ul class="nayro-filter-list">
              {%- for value in filter.values -%}
                {%- assign is_disabled = false -%}
                {%- if value.count == 0 and value.active == false -%}
                  {%- assign is_disabled = true -%}
                {%- endif -%}
                <li class="nayro-filter-item{% if value.active %} is-active{% endif %}{% if is_disabled %} is-disabled{% endif %}">
                  <label>
                    <input
                      type="checkbox"
                      name="{{ value.param_name }}"
                      value="{{ value.value }}"
                      {% if value.active %}checked{% endif %}
                      {% if is_disabled %}disabled{% endif %}
                      data-facet-input
                    >
                    <span class="nayro-filter-item__label">{{ value.label | escape }}</span>
                    <span class="nayro-filter-item__count">{{ value.count }}</span>
                  </label>
                </li>
              {%- endfor -%}
            </ul>
        {%- endcase -%}
      </details>
    {%- endfor -%}

    {%- if show_fallback_types -%}
      <details class="nayro-filter-group" {% if current_type_key != blank %}open{% endif %}>
        <summary class="nayro-filter-group__title">{{ 'collections.general.category' | t }}</summary>
        <ul class="nayro-filter-list nayro-filter-list--scroll">
          {%- for product_type in results.all_types -%}
            {%- assign type_key = product_type | downcase -%}
            {%- assign type_q = product_type | url_encode -%}
            {%- assign type_url = routes.collections_url | append: '/types?q=' | append: type_q -%}
            {%- if current_sort != blank -%}
              {%- assign type_url = type_url | append: '&sort_by=' | append: current_sort -%}
            {%- endif -%}
            <li class="nayro-filter-item{% if type_key == current_type_key %} is-active{% endif %}">
              <a href="{{ type_url }}"{% if type_key == current_type_key %} class="is-active" aria-current="page"{% endif %}>
                <span class="nayro-filter-item__label">{{ product_type | escape }}</span>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </details>
    {%- endif -%}

    {%- if show_brand_filter -%}
      <details class="nayro-filter-group" {% if current_vendor_key != blank %}open{% endif %} data-brand-group>
        <summary class="nayro-filter-group__title">
          {{ 'collections.general.brand' | t }}
          <span class="nayro-filter-group__count">{{ brand_total }}</span>
        </summary>
        <div class="nayro-brand-search">
          <input
            type="search"
            class="nayro-brand-search__input"
            placeholder="{{ 'collections.general.search_brand' | t }}"
            aria-label="{{ 'collections.general.search_brand' | t }}"
            autocomplete="off"
            data-brand-search
          >
        </div>
        <ul class="nayro-filter-list nayro-filter-list--scroll" data-brand-list>
          {%- for product_vendor in brand_list -%}
            {%- assign vendor_clean = product_vendor | strip -%}
            {%- if vendor_clean == blank -%}{%- continue -%}{%- endif -%}
            {%- assign vendor_key = vendor_clean | downcase -%}
            {%- assign vendor_count = 0 -%}
            {%- for filter in results.filters -%}
              {%- if filter.param_name == 'filter.p.vendor' -%}
                {%- for value in filter.values -%}
                  {%- assign value_key = value.label | strip | downcase -%}
                  {%- if value_key == vendor_key -%}
                    {%- assign vendor_count = value.count -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            {%- endfor -%}
            {%- assign vendor_q = vendor_clean | url_encode -%}
            {%- assign vendor_url = routes.collections_url | append: '/vendors?q=' | append: vendor_q -%}
            {%- if current_sort != blank -%}
              {%- assign vendor_url = vendor_url | append: '&sort_by=' | append: current_sort -%}
            {%- endif -%}
            {%- if vendor_key == current_vendor_key -%}
              {%- assign vendor_url = reset_url -%}
            {%- endif -%}
            <li class="nayro-filter-item{% if vendor_key == current_vendor_key %} is-active{% endif %}" data-brand-name="{{ vendor_key | escape }}">
              <a href="{{ vendor_url }}"{% if vendor_key == current_vendor_key %} class="is-active" aria-current="page"{% endif %}>
                <span class="nayro-filter-item__label">{{ vendor_clean | escape }}</span>
                {%- if vendor_count > 0 -%}
                  <span class="nayro-filter-item__count">{{ vendor_count }}</span>
                {%- endif -%}
              </a>
            </li>
          {%- endfor -%}
        </ul>
        <p class="nayro-brand-search__empty" data-brand-empty hidden>{{ 'collections.general.no_brand_matches' | t }}</p>
      </details>
    {%- endif -%}

    {%- if results.filters.size > 0 -%}
      <div class="nayro-filters__actions">
        <button type="submit" class="nayro-btn nayro-btn--primary nayro-btn--sm nayro-btn--block">
          {{ 'collections.general.apply' | t }}
        </button>
      </div>
    {%- endif -%}
  </form>
{%- endif -%}
