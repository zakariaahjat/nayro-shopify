    {%- when 'youtube' -%}<rect x="2.5" y="6" width="19" height="12" rx="4"/><path d="m10 9 5 3-5 3z"/>
    {%- when 'x' -%}<path d="M4 4l16 16M20 4L4 20"/>
    {%- when 'whatsapp' -%}<path d="M20.5 11.6a8.5 8.5 0 0 1-12.6 7.5L3 20.5l1.5-4.8A8.5 8.5 0 1 1 20.5 11.6z"/><path d="M8.6 8.2c.3-.1.6 0 .7.3l.8 1.8c.1.2 0 .5-.2.6l-.6.5c.6 1.2 1.5 2 2.7 2.6l.5-.6c.2-.2.4-.3.6-.2l1.8.8c.2.1.4.4.3.7-.2 1-.9 1.6-1.9 1.7-1.8.2-3.6-.6-5-1.9-1.5-1.4-2.4-3.2-2.1-5 0-1 .7-1.8 1.7-2z"/>
    {%- when 'external' -%}<path d="M14 3h7v7"/><path d="M21 3l-9 9"/><path d="M21 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5"/>
    {%- else -%}<circle cx="12" cy="12" r="9"/>
  {%- endcase -%}
</svg>
