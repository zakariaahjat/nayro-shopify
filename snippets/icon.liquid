{%- comment -%}
  Inline icon set. Usage: {% render 'icon', name: 'cart', class: 'nayro-icon' %}
{%- endcomment -%}
{%- liquid
  assign icon_class = class | default: 'nayro-icon'
  assign fill = 'none'
  if name == 'star'
    assign fill = 'currentColor'
  endif
-%}
<svg class="{{ icon_class }}" width="24" height="24" viewBox="0 0 24 24" fill="{{ fill }}" stroke="{% if name == 'star' %}none{% else %}currentColor{% endif %}" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'shield' -%}<path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6l8-3z"/><path d="m9 12 2 2 4-4"/>
    {%- when 'truck' -%}<path d="M3 7h11v9H3z"/><path d="M14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/>
    {%- when 'check' -%}<circle cx="12" cy="12" r="9"/><path d="m8 12 2.5 2.5L16 9"/>
    {%- when 'cash' -%}<rect x="3" y="6" width="18" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/>
    {%- when 'search' -%}<circle cx="11" cy="11" r="6"/><path d="m20 20-4-4"/>
    {%- when 'chat' -%}<path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"/>
    {%- when 'box' -%}<path d="M3 7l9-4 9 4v10l-9 4-9-4z"/><path d="M3 7l9 4 9-4M12 11v10"/>
    {%- when 'tag' -%}<path d="M3 12V4h8l10 10-8 8z"/><circle cx="7.5" cy="8.5" r="1.2"/>
    {%- when 'arrow' -%}<path d="M5 12h14M13 6l6 6-6 6"/>
    {%- when 'bolt' -%}<path d="M13 2 4 14h7l-1 8 9-12h-7z"/>
    {%- when 'pin' -%}<path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/>
    {%- when 'user' -%}<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
    {%- when 'heart' -%}<path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1L12 21l7.7-7.6 1.1-1a5.5 5.5 0 0 0 0-7.8z"/>
