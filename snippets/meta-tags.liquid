{%- liquid
  assign seo_title = page_title | default: shop.name
  assign seo_description = page_description | default: shop.description | default: shop.name
  assign seo_image = page_image
  assign item_condition = 'new'
  if template.name == 'product' and product != blank
    assign product_tags_string = product.tags | join: ',' | downcase
    if product_tags_string contains 'refurbished'
      assign item_condition = 'refurbished'
    elsif product_tags_string contains 'used'
      assign item_condition = 'used'
    endif
  endif
  if seo_image == blank and settings.social_image != blank
    assign seo_image = settings.social_image
  endif
  if template.name == 'index'
    assign seo_title = shop.name
    if shop.description != blank
      assign seo_description = shop.description
    endif
  endif
  if template.name == 'product' and product != blank
    assign seo_title = product.title | append: ' – ' | append: shop.name
    if product.description != blank
      assign seo_description = product.description | strip_html | truncatewords: 30
    endif
    if product.featured_image != blank
      assign seo_image = product.featured_image
    endif
  endif
  if template.name == 'article' and article != blank
    assign seo_title = article.title | append: ' – ' | append: shop.name
    if article.excerpt != blank
      assign seo_description = article.excerpt | strip_html | truncatewords: 30
    elsif article.content != blank
      assign seo_description = article.content | strip_html | truncatewords: 30
    endif
    if article.image != blank
      assign seo_image = article.image
    endif
  endif
  if template.name == 'collection' and collection != blank
    assign seo_title = collection.title | append: ' – ' | append: shop.name
    if collection.description != blank
      assign seo_description = collection.description | strip_html | truncatewords: 30
    endif
    if collection.image != blank
      assign seo_image = collection.image
    endif
  endif
  if template.name == '404'
    assign seo_title = '404 – ' | append: shop.name
  endif
-%}
<title>{{ seo_title | escape }}</title>
{%- if seo_description != blank %}
  <meta name="description" content="{{ seo_description | escape }}">
{%- endif %}
<link rel="canonical" href="{{ canonical_url }}">
{%- if settings.favicon != blank %}
  <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 96 }}">
{%- endif %}
<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ seo_title | escape }}">
<meta property="og:type" content="{% if template.name == 'product' %}product{% elsif template.name == 'article' %}article{% else %}website{% endif %}">
<meta property="og:description" content="{{ seo_description | escape }}">
{%- if seo_image != blank %}
  <meta property="og:image" content="https:{{ seo_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ seo_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content="https:{{ seo_image | image_url: width: 1200 }}">
{%- else %}
  <meta name="twitter:card" content="summary">
{%- endif %}
<meta name="twitter:title" content="{{ seo_title | escape }}">
<meta name="twitter:description" content="{{ seo_description | escape }}">
{%- if template.name == 'product' and product != blank %}
  <meta property="product:price:amount" content="{{ product.price | divided_by: 100.0 }}">
  <meta property="product:price:currency" content="{{ cart.currency.iso_code | default: shop.currency }}">
{%- endif %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": {{ shop.name | json }},
  "url": {{ shop.url | json }},
  {%- if settings.logo != blank %}
  "logo": {{ settings.logo | image_url: width: 600 | prepend: 'https:' | json }},
  {%- else %}
  "logo": {{ 'nayro-logo.png' | asset_url | prepend: 'https:' | json }},
  {%- endif %}
  "sameAs": [
    {%- assign social_urls = '' -%}
    {%- if settings.social_instagram != blank %}{% assign social_urls = social_urls | append: settings.social_instagram | append: '|' %}{% endif -%}
    {%- if settings.social_facebook != blank %}{% assign social_urls = social_urls | append: settings.social_facebook | append: '|' %}{% endif -%}
    {%- if settings.social_tiktok != blank %}{% assign social_urls = social_urls | append: settings.social_tiktok | append: '|' %}{% endif -%}
    {%- if settings.social_youtube != blank %}{% assign social_urls = social_urls | append: settings.social_youtube | append: '|' %}{% endif -%}
    {%- if settings.social_x != blank %}{% assign social_urls = social_urls | append: settings.social_x | append: '|' %}{% endif -%}
    {%- if social_urls != blank -%}
      {%- assign social_list = social_urls | split: '|' -%}
      {%- for url in social_list -%}{{ url | json }}{% unless forloop.last %},{% endunless %}{%- endfor -%}
    {%- endif -%}
  ]
}
</script>
{%- if template.name == 'product' and product != blank %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  "url": {{ request.origin | append: product.url | json }},
  {%- if product.featured_image != blank %}
  "image": [{{ product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }}],
  {%- endif %}
  "description": {{ product.description | strip_html | truncatewords: 60 | json }},
  {%- if product.vendor != blank %}
  "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
  {%- endif %}
  {%- if product.selected_or_first_available_variant.sku != blank %}
  "sku": {{ product.selected_or_first_available_variant.sku | json }},
  {%- endif %}
  "offers": [
    {%- for variant in product.variants -%}
    {
      "@type": "Offer",
      "url": {{ request.origin | append: product.url | append: '?variant=' | append: variant.id | json }},
      "priceCurrency": {{ cart.currency.iso_code | default: shop.currency | json }},
      "price": {{ variant.price | divided_by: 100.0 | json }},
      "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
      "itemCondition": "https://schema.org/{% if item_condition == 'used' %}UsedCondition{% elsif item_condition == 'refurbished' %}RefurbishedCondition{% else %}NewCondition{% endif %}",
      "name": {{ variant.title | json }}
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>
{%- endif %}
