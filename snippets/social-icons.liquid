{%- comment -%}
  Renders the configured social links. Accepts: class (optional).
{%- endcomment -%}
{%- liquid
  assign social_class = class | default: 'nayro-socials'
  assign has_social = false
  if settings.social_instagram != blank or settings.social_facebook != blank or settings.social_tiktok != blank or settings.social_youtube != blank or settings.social_x != blank
    assign has_social = true
  endif
-%}
{%- if has_social -%}
  <ul class="{{ social_class }}">
    {%- if settings.social_instagram != blank -%}
      <li><a href="{{ settings.social_instagram }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram">{% render 'icon', name: 'instagram' %}</a></li>
    {%- endif -%}
    {%- if settings.social_facebook != blank -%}
      <li><a href="{{ settings.social_facebook }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook">{% render 'icon', name: 'facebook' %}</a></li>
    {%- endif -%}
    {%- if settings.social_tiktok != blank -%}
      <li><a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener noreferrer" aria-label="TikTok">{% render 'icon', name: 'tiktok' %}</a></li>
    {%- endif -%}
    {%- if settings.social_youtube != blank -%}
      <li><a href="{{ settings.social_youtube }}" target="_blank" rel="noopener noreferrer" aria-label="YouTube">{% render 'icon', name: 'youtube' %}</a></li>
    {%- endif -%}
    {%- if settings.social_x != blank -%}
      <li><a href="{{ settings.social_x }}" target="_blank" rel="noopener noreferrer" aria-label="X">{% render 'icon', name: 'x' %}</a></li>
    {%- endif -%}
  </ul>
{%- endif -%}
