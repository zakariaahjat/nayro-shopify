    "how_it_works": {
      "type": "how-it-works",
      "blocks": {
        "step_1": {
          "type": "step",
          "settings": {
            "icon": "search",
            "title": "Find your product",
            "text": "Browse by category or condition and compare prices."
          }
        },
        "step_2": {
          "type": "step",
          "settings": {
            "icon": "chat",
            "title": "Order or ask us",
            "text": "Checkout online or confirm details with us on WhatsApp."
          }
        },
        "step_3": {
          "type": "step",
          "settings": {
            "icon": "box",
            "title": "Get it delivered",
            "text": "We prepare, check and ship your order to your door."
          }
        },
        "step_4": {
          "type": "step",
          "settings": {
            "icon": "shield",
            "title": "Enjoy with support",
            "text": "Warranty and after-sales help when you need it."
          }
        }
      },
      "block_order": ["step_1", "step_2", "step_3", "step_4"],
      "settings": {}
    },
