  "sections": {
    "hero": {
      "type": "hero-banner",
      "blocks": {
        "slide_1": {
          "type": "slide",
          "settings": {
            "heading": "Everything you need, new or used",
            "text": "Laptops, phones and components, checked, guaranteed and delivered to your door.",
            "button_label": "Shop now"
          }
        },
        "slide_2": {
          "type": "slide",
          "settings": {
            "heading": "Tech you can trust, prices you will love",
            "text": "New, used and refurbished devices with warranty and fast delivery.",
            "button_label": "Browse deals"
          }
        }
      },
      "block_order": ["slide_1", "slide_2"],
      "settings": {
        "show_search": true,
        "show_chips": true
      }
    },
